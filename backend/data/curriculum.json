    {
        "id": 9,
        "title": "Perfect Tense & Housing",
        "summary": "The Perfect form (spoken past), Partizip II, Haben vs. Sein, Apartment vocabulary.",
        "key_vocab": [
            {
                "german": "die Wohnung",
                "english": "apartment",
                "gender": "feminine"
            },
