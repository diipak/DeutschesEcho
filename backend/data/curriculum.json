        "grammar_rules": [
            {
                "rule_name": "Nominative Adjective Endings (Definite)",
                "logic": "Der/Die/Das + Adj -> add '-e' (der alte Mann). Plural + Adj -> add '-en'."
            },
            {
                "rule_name": "Nominative Adjective Endings (Indefinite)",
                "logic": "Ein (Masc) -> -er (ein alter Mann). Ein (Neut) -> -es (ein kleines Kind). Eine (Fem) -> -e."
            }
        ],
        "dialogue": {
            "speakerA": "Magst du das rote Auto?",
            "speakerB": "Nein, ich mag das blaue Auto.",
            "speakerA": "Das ist ein schönes Haus."
        }
