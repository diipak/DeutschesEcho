[
    {
        "id": 1,
        "title": "Basics of German Language",
        "summary": "Covers the German alphabet, sounds and pronunciations (vowels, dipthongs), basic greetings, farewells, and the self-introduction structure.",
        "key_vocab": [
            {
                "german": "Hallo",
                "english": "Hello",
                "gender": "none"
            },
            {
                "german": "Guten Tag",
                "english": "Good day",
                "gender": "none"
            },
            {
                "german": "Tschüss",
                "english": "Bye",
                "gender": "none"
            },
            {
                "german": "Ich heiße...",
                "english": "My name is...",
                "gender": "none"
            },
            {
                "german": "Buchstabieren",
                "english": "To spell",
                "gender": "none"
            }
        ],
        "grammar_rules": [
            {
                "rule_name": "Vowel Length",
                "logic": "Long sound if followed by 1 consonant (e.g., 'Name'). Short sound if followed by 2 consonants (e.g., 'Hallo')."
            },
            {
                "rule_name": "Dipthong Pronunciation",
                "logic": "'ei' sounds like 'eye' (Eis). 'ie' sounds like 'ee' (Brief). 'eu/äu' sounds like 'oy' (Euro)."
            },
            {
                "rule_name": "Consonant Sounds",
                "logic": "'w' = English 'v'. 'v' = English 'f'. 'st/sp' at start = 'sht/shp'."
            }
        ],
        "dialogue": {
            "speakerA": "Hallo, ich heiße Thomas. Wie heißt du?",
            "speakerB": "Hallo, ich bin Julia. Ich komme aus Deutschland."
        }
    },
    {
        "id": 2,
        "title": "Articles & Nouns",
        "summary": "Introduction to definite (der, die, das) and indefinite articles, noun gender rules, compound nouns, and asking 'what is that?'.",
        "key_vocab": [
            {
                "german": "der Tisch",
                "english": "the table",
                "gender": "masculine"
            },
            {
                "german": "die Frau",
                "english": "the woman",
                "gender": "feminine"
            },
            {
                "german": "das Kind",
                "english": "the child",
                "gender": "neutral"
            },
            {
                "german": "Was ist das?",
                "english": "What is that?",
                "gender": "none"
            },
            {
                "german": "die Woche",
                "english": "the week",
                "gender": "feminine"
            }
        ],
        "grammar_rules": [
            {
                "rule_name": "Gender Suffixes (Masculine)",
                "logic": "Endings: -ig, -ling, -or, -ismus. Categories: Days, Months, Seasons, Directions."
            },
            {
                "rule_name": "Gender Suffixes (Feminine)",
                "logic": "Endings: -ung, -heit, -keit, -tät, -ion, -ik, -ie, -e (mostly). Category: Numbers."
            },
            {
                "rule_name": "Gender Suffixes (Neutral)",
                "logic": "Endings: -chen, -lein, -ment, -um. Categories: Colors, Metals."
            },
            {
                "rule_name": "Compound Nouns",
                "logic": "The article is determined by the LAST word in the combination (e.g., Das Wasser + Die Flasche = Die Wasserflasche)."
            }
        ],
        "dialogue": {
            "speakerA": "Was ist das?",
            "speakerB": "Das ist ein Stuhl.",
            "speakerA": "Ist der Stuhl neu?",
            "speakerB": "Ja, er ist neu."
        }
    },
    {
        "id": 3,
        "title": "Pronouns, Numbers & Dates",
        "summary": "Personal pronouns, singular vs plural noun formation, numbers 0-1M, phone numbers, ordinal numbers for dates.",
        "key_vocab": [
            {
                "german": "wir",
                "english": "we",
                "gender": "none"
            },
            {
                "german": "ihr",
                "english": "you all (informal)",
                "gender": "none"
            },
            {
                "german": "zwanzig",
                "english": "twenty",
                "gender": "none"
            },
            {
                "german": "der erste",
                "english": "the first",
                "gender": "masculine"
            },
            {
                "german": "Wann",
                "english": "When",
                "gender": "none"
            }
        ],
        "grammar_rules": [
            {
                "rule_name": "Number Logic (21-99)",
                "logic": "Read backwards: Unit + und + Ten. E.g., 21 is 'ein-und-zwanzig' (one-and-twenty)."
            },
            {
                "rule_name": "Ordinal Numbers",
                "logic": "1-19: Add '-te' (vierte). 20+: Add '-ste' (zwanzigste). Exceptions: erste (1st), dritte (3rd), siebte (7th)."
            },
            {
                "rule_name": "Plural Formation",
                "logic": "Masculine often adds '-e'. Feminine often adds '-en'. Neutral often adds '-er'. Words ending in -er/-el often change only article."
            }
        ],
        "dialogue": {
            "speakerA": "Wie ist deine Telefonnummer?",
            "speakerB": "Meine Nummer ist null-eins-fünf...",
            "speakerA": "Wann hast du Geburtstag?",
            "speakerB": "Am fünften Mai."
        }
    },
    {
        "id": 4,
        "title": "Sentence Structure & Time",
        "summary": "Basic sentence structure, present tense verbs, negation with 'nicht'/'kein', telling time (formal/informal).",
        "key_vocab": [
            {
                "german": "spät",
                "english": "late",
                "gender": "none"
            },
            {
                "german": "halb",
                "english": "half (time)",
                "gender": "none"
            },
            {
                "german": "Viertel",
                "english": "quarter",
                "gender": "neutral"
            },
            {
                "german": "bezahlen",
                "english": "to pay",
                "gender": "none"
            },
            {
                "german": "nicht",
                "english": "not",
                "gender": "none"
            }
        ],
        "grammar_rules": [
            {
                "rule_name": "Golden Rule (Position 2)",
                "logic": "The conjugated verb must always be in Position 2. The subject is usually Pos 1 or 3."
            },
            {
                "rule_name": "Informal Time",
                "logic": "'Halb' + Next Hour (e.g., 8:30 is 'Halb neun'). Use 'vor' (to) and 'nach' (past) the hour."
            },
            {
                "rule_name": "Negation Logic",
                "logic": "Use 'Kein' for indefinite nouns (no car). Use 'Nicht' for verbs, adjectives, and definite nouns."
            }
        ],
        "dialogue": {
            "speakerA": "Wie spät ist es?",
            "speakerB": "Es ist halb drei.",
            "speakerA": "Ich möchte bitte zahlen.",
            "speakerB": "Zusammen oder getrennt?"
        }
    },
