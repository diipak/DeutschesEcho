        ],
        "grammar_rules": [
            {
                "rule_name": "Question Structure",
                "logic": "Ja/Nein Questions: Verb comes first (Pos 1). W-Questions: W-word (Pos 1) + Verb (Pos 2)."
            },
            {
                "rule_name": "Time Prepositions",
                "logic": "'Um' for exact time (Um 8 Uhr). 'Am' for days/dates (Am Montag). 'Im' for months/seasons (Im Sommer)."
            }
        ],
        "dialogue": {
            "speakerA": "Woher kommst du?",
            "speakerB": "Ich komme aus Spanien.",
