                "english": "driven",
                "gender": "none"
            },
            {
                "german": "das Wochenende",
                "english": "weekend",
                "gender": "neutral"
            }
        ],
        "grammar_rules": [
            {
                "rule_name": "Perfect Construction",
                "logic": "Helper (Haben/Sein) at Pos 2 + Partizip II at End."
            },
            {
                "rule_name": "Haben vs Sein",
                "logic": "Use 'Sein' for movement (fahren, gehen) or state change (aufstehen, sterben). Use 'Haben' for everything else."
            },
            {
                "rule_name": "Partizip II -ieren exception",
                "logic": "Verbs ending in -ieren do not get 'ge-'. (studieren -> studiert)."
            }
        ],
        "dialogue": {
            "speakerA": "Was hast du am Wochenende gemacht?",
            "speakerB": "Ich bin nach Hause gefahren und habe gelernt."
        }
    },
