        ],
        "grammar_rules": [
            {
                "rule_name": "Accusative Change",
                "logic": "Only Masculine changes: Der -> Den, Ein -> Einen, Kein -> Keinen. Feminine/Neutral/Plural stay same."
            },
            {
                "rule_name": "Subject vs Object",
                "logic": "Subject (Nominative) does the action. Object (Accusative) receives the action."
            }
        ],
        "dialogue": {
            "speakerA": "Ich suche einen Job.",
            "speakerB": "Hast du den Chef angerufen?",
            "speakerA": "Nein, ich rufe ihn gleich an."
        }
